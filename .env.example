# Banco das impressoras; use host acessível de dentro do contêiner.
MARIADB_HOST=mariadb.exemplo.com
MARIADB_PORT=3306
MARIADB_USER=monitor
MARIADB_PASSWORD=troque-esta-senha
MARIADB_DATABASE=impressoras

# Opcional: aponte para o banco atual do MonitorNet para manter seus dados.
# Deixe em branco para usar o banco acima.
NETWORK_MARIADB_HOST=
NETWORK_MARIADB_PORT=
NETWORK_MARIADB_USER=
NETWORK_MARIADB_PASSWORD=
NETWORK_MARIADB_DATABASE=

NETWORK_MONITOR_INTERVAL_SECONDS=5
NETWORK_PING_COUNT=4
NETWORK_PING_TIMEOUT_MS=1000
NETWORK_SNMP_INTERVAL_SECONDS=60
NETWORK_STABILITY_WINDOW=20
NETWORK_MAX_ENTRIES=1000
NETWORK_PING_CONCURRENCY=8
NETWORK_HISTORY_RETENTION_DAYS=1
NETWORK_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# Opcional: proteção das duas APIs por HTTP Basic.
API_USER=
API_PASSWORD=

# Opcional: alertas de indisponibilidade da rede.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_TIMEZONE=America/Fortaleza
NOTIFICATION_OUTAGE_MINUTES=30
